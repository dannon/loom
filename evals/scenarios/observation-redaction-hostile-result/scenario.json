{
  "name": "nothing identifying survives the observation validator",
  "description": "A hostile galaxy_run_tool failure -- absolute path, project directory name, 32-hex dataset id, five-digit history number, dataset URL and email address, all on the one line the normalizer reads -- plus hostile tool arguments, replayed through the real build-and-check path with no model attached, in the default ask shape. The leak scan runs over the raw line before the normalizer rewrites it, so every hostile line is refused outright rather than scrubbed and sent; the same line three times is still reported once as a retry-loop, and refused again. A fifth, clean failure shows what does pass. No activity row carries a signature at all; the exact signatures are pinned by the unit test over the same fixture. The replay reaches the build step only, so nothing may be sent.",
  "tier": 1,
  "inputs": ["/observations status"],
  "env": {
    "ANTHROPIC_API_KEY": "fake-eval-key",
    "LOOM_OBSERVATION_REPLAY": "observations.jsonl",
    "GALAXY_URL": "https://usegalaxy.org",
    "GALAXY_API_KEY": "fake-eval-galaxy-key"
  },
  "timeoutMs": 15000,
  "assertions": {
    "events": {
      "mustNotInclude": ["agent_start", "tool_execution_start", "turn_start"]
    },
    "activity": {
      "mustNotIncludeKinds": [
        "observation.sent",
        "observation.queued",
        "observation.invalid",
        "observation.declined",
        "observation.skipped"
      ],
      "mustInclude": [
        {
          "kind": "observation.replay",
          "source": "observation-replay",
          "payloadContains": {
            "file": "observations.jsonl",
            "entries": "5"
          }
        },
        {
          "kind": "observation.built",
          "source": "observation-replay",
          "payloadContains": {
            "kind": "tool-error",
            "trigger": "tool_error",
            "stage": "tool-parameterization",
            "shape": "full",
            "mcpTool": "galaxy_run_tool",
            "toolIds": "toolshed.g2.bx.psu.edu/repos/iuc/hisat2/hisat2",
            "datatypes": "fastqsanger.gz",
            "server": "usegalaxy.org",
            "descriptionLength": "0",
            "leakScan": "dirty"
          }
        },
        {
          "kind": "observation.built",
          "source": "observation-replay",
          "payloadContains": {
            "kind": "tool-error",
            "toolIds": "",
            "datatypes": "",
            "leakScan": "dirty"
          }
        },
        {
          "kind": "observation.built",
          "source": "observation-replay",
          "payloadContains": {
            "kind": "retry-loop",
            "trigger": "retry_loop",
            "leakScan": "dirty"
          }
        },
        {
          "kind": "observation.built",
          "source": "observation-replay",
          "payloadContains": {
            "kind": "tool-error",
            "trigger": "tool_error",
            "stage": "tool-parameterization",
            "shape": "full",
            "mcpTool": "galaxy_run_tool",
            "toolIds": "toolshed.g2.bx.psu.edu/repos/iuc/hisat2/hisat2",
            "datatypes": "fastqsanger.gz",
            "server": "usegalaxy.org",
            "valid": "true",
            "leakScan": "clean"
          }
        }
      ]
    }
  }
}
